# PostgreSQL Database Configuration
# If left blank or connection fails, the application automatically falls back to local SQLite (data/employee_analytics.db)
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=employee_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Alternatively, specify a full Database URL (e.g. Supabase, Neon, AWS RDS, or local PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/employee_db
